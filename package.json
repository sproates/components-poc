{
  "name": "@poc/design-system-components",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "type": "module",
  "description": "POC reusable TypeScript component library with Storybook functional and performance testing.",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms.js"
    },
    "./atoms/Button": {
      "types": "./dist/atoms/Button/index.d.ts",
      "import": "./dist/Button.js"
    },
    "./atoms/Checkbox": {
      "types": "./dist/atoms/Checkbox/index.d.ts",
      "import": "./dist/Checkbox.js"
    },
    "./atoms/TextInput": {
      "types": "./dist/atoms/TextInput/index.d.ts",
      "import": "./dist/TextInput.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules.js"
    },
    "./molecules/FormField": {
      "types": "./dist/molecules/FormField/index.d.ts",
      "import": "./dist/FormField.js"
    },
    "./molecules/LoginForm": {
      "types": "./dist/molecules/LoginForm/index.d.ts",
      "import": "./dist/LoginForm.js"
    },
    "./atoms/Label": {
      "types": "./dist/atoms/Label/index.d.ts",
      "import": "./dist/Label.js"
    },
    "./atoms/Badge": {
      "types": "./dist/atoms/Badge/index.d.ts",
      "import": "./dist/Badge.js"
    },
    "./atoms/IconButton": {
      "types": "./dist/atoms/IconButton/index.d.ts",
      "import": "./dist/IconButton.js"
    },
    "./atoms/Spinner": {
      "types": "./dist/atoms/Spinner/index.d.ts",
      "import": "./dist/Spinner.js"
    },
    "./atoms/TextArea": {
      "types": "./dist/atoms/TextArea/index.d.ts",
      "import": "./dist/TextArea.js"
    },
    "./atoms/Switch": {
      "types": "./dist/atoms/Switch/index.d.ts",
      "import": "./dist/Switch.js"
    },
    "./atoms/RadioGroup": {
      "types": "./dist/atoms/RadioGroup/index.d.ts",
      "import": "./dist/RadioGroup.js"
    },
    "./molecules/Dialog": {
      "types": "./dist/molecules/Dialog/index.d.ts",
      "import": "./dist/Dialog.js"
    },
    "./molecules/Combobox": {
      "types": "./dist/molecules/Combobox/index.d.ts",
      "import": "./dist/Combobox.js"
    },
    "./molecules/Tabs": {
      "types": "./dist/molecules/Tabs/index.d.ts",
      "import": "./dist/Tabs.js"
    },
    "./molecules/Toast": {
      "types": "./dist/molecules/Toast/index.d.ts",
      "import": "./dist/Toast.js"
    },
    "./organisms": {
      "types": "./dist/organisms/index.d.ts",
      "import": "./dist/organisms.js"
    },
    "./organisms/DataTable": {
      "types": "./dist/organisms/DataTable/index.d.ts",
      "import": "./dist/DataTable.js"
    },
    "./organisms/ValidatedForm": {
      "types": "./dist/organisms/ValidatedForm/index.d.ts",
      "import": "./dist/ValidatedForm.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "build:all": "npm run typecheck && npm run build && npm run build:storybook",
    "storybook": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.cache/ms-playwright STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "serve:storybook": "node scripts/serve-storybook.mjs",
    "build:storybook": "HOME=$PWD/.cache/storybook STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.cache/ms-playwright playwright install chromium",
    "test": "npm run test:all",
    "test:functional": "node scripts/run-tests.mjs functional",
    "test:functional:ci": "npm run test:functional",
    "test:perf": "node scripts/run-tests.mjs perf",
    "test:all": "npm run typecheck && npm run build && npm run test:package && node scripts/run-tests.mjs all",
    "test:package": "node scripts/check-package.mjs && tsc --ignoreConfig --noEmit --skipLibCheck --moduleResolution bundler --module esnext --jsx react-jsx --types react,node tests/package-consumer.tsx",
    "report:perf": "playwright show-report --host 127.0.0.1 --port 0",
    "demo:comparisons": "node scripts/run-tests.mjs perf --grep 'detector accepts'",
    "demo:failures": "DEMO_FAILURES=1 node scripts/run-tests.mjs perf --grep 'intentional failures'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-table": "^9.3.1",
    "lucide-react": "^1.67.0",
    "react-aria-components": "^1.22.1",
    "react-hook-form": "^7.91.0"
  }
}
